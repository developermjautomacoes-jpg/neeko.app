# Exemplo sem credenciais reais. Ajustar por aplicação/ambiente.
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Banco local — substituir apenas com credenciais locais de desenvolvimento
DATABASE_URL=postgresql://neeko:neeko_local_only@localhost:5432/neeko_dev?schema=public

# Redis local
REDIS_URL=redis://localhost:6379

# Auth: definir secrets fortes fora do repositório
AUTH_SECRET=replace-with-a-long-random-secret
