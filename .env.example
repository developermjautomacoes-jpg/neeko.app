# Exemplo sem credenciais reais. Em produção, defina no Easypanel.
NODE_ENV=development

# API
PORT=4000
DATABASE_URL=postgresql://neeko:neeko@localhost:5432/neeko
# Gere com: openssl rand -base64 32. Trocar invalida os certificados guardados.
CERT_ENCRYPTION_KEY=
RUN_MIGRATIONS=true
SCHEDULER_ENABLED=true
# Só no primeiro início, com o banco vazio. A senha é provisória e será trocada no primeiro acesso.
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ADMIN_NAME=
# E-mail da redefinição de senha
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Importação de pacotes de migração (desligada por padrão)
OFFICE_IMPORT_ENABLED=false

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Opcional: arquivo PEM com a cadeia ICP-Brasil, se a SEFAZ não for reconhecida.
FISCAL_CA_FILE=

# Web
API_INTERNAL_URL=http://localhost:4000
