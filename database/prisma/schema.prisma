// Neeko Platform. Regras: ADR-002 (escopo por organização), ADR-004 (identidade) e ADR-005 (RBAC).
// Toda tabela de negócio carrega organizationId; as filhas repetem a organização na chave estrangeira.
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  NEEKO_SUPERADMIN
  USER
}

enum OrgRole {
  ORG_OWNER
  ORG_ADMIN
  STAFF
  COMPANY_USER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

/// Plano comercial. A cobrança é controlada manualmente pela Neeko.
model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  maxCompanies Int?
  maxUsers     Int?
  monthlyPrice Decimal  @default(0) @db.Decimal(12, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  organizations Organization[]
}

model Organization {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  cnpj         String    @default("")
  contactEmail String    @default("")
  contactPhone String    @default("")
  status       OrgStatus @default(ACTIVE)
  /// Organização interna da Neeko: não é suspensa nem tem limites.
  internal     Boolean   @default(false)
  planId       String?   @db.Uuid
  paidUntil    String    @default("")
  notes        String    @default("")
  createdAt    DateTime  @default(now())

  plan Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  memberships  OrganizationMembership[]
  companies    Company[]
  certificates FiscalCertificate[]
  settings     FiscalSettings?
  /// Pagamentos acima deste valor exigem aprovação; nulo = sem aprovação.
  approvalLimit Decimal? @db.Decimal(15, 2)
  auditEvents  AuditEvent[]
}

/// Identidade global da pessoa. A senha é individual e só existe como hash scrypt.
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique
  name               String
  passwordHash       String
  mustChangePassword Boolean    @default(true)
  /// Foto de perfil já recortada, em data URL JPEG.
  avatar             String?
  jobTitle           String     @default("")
  phone              String     @default("")
  /// Segredo TOTP cifrado; verificação em duas etapas.
  mfaSecret          Bytes?
  mfaEnabled         Boolean    @default(false)
  mfaLastStep        BigInt     @default(0)
  /// SHA-256 dos códigos de recuperação ainda não usados.
  mfaRecovery        Json       @default("[]")
  globalRole         GlobalRole @default(USER)
  active             Boolean    @default(true)
  createdAt          DateTime   @default(now())

  memberships OrganizationMembership[]
  sessions    Session[]
}

/// O cookie guarda só o token aleatório; aqui fica o SHA-256 dele.
model Session {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String?  @db.Uuid
  tokenHash      String   @unique
  mfaVerified    Boolean  @default(false)
  /// Perfil privilegiado ainda sem verificação em duas etapas.
  mfaSetupRequired Boolean @default(false)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           OrgRole
  status         MembershipStatus @default(ACTIVE)
  /// Grant explícito para toda a carteira; sem ele vale CompanyAccess.
  allCompanies   Boolean          @default(false)
  createdAt      DateTime         @default(now())

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  MembershipPermission[]
  companies    CompanyAccess[]

  @@unique([userId, organizationId])
  @@unique([organizationId, id])
}

model MembershipPermission {
  membershipId String                 @db.Uuid
  permission   String
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, permission])
}

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  cnpj           String
  legalName      String
  active         Boolean  @default(true)
  /// certificado | procuracao (a procuração vale só para NFS-e)
  nfseMode       String   @default("certificado")
  certificateId  String?  @db.Uuid
  dfeAutoCapture Boolean  @default(false)
  dfeAutoCiencia Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  access       CompanyAccess[]
  nfseStates   NfseState[]
  nfseDocs     NfseDocument[]
  nfseEvents   NfseEvent[]
  nfseFailures NfseFailure[]
  dfeStates    DfeState[]
  dfeDocs      DfeDocument[]
  dfeEvents    DfeEvent[]
  dfeFailures  DfeFailure[]
  memoranda    Memorandum[]
  finAccounts   FinAccount[]
  finCategories FinCategory[]
  costCenters   CostCenter[]
  finEntries    FinEntry[]
  stockItems    StockItem[]

  @@unique([organizationId, cnpj])
  @@unique([organizationId, id])
}

model CompanyAccess {
  organizationId String                 @db.Uuid
  membershipId   String                 @db.Uuid
  companyId      String                 @db.Uuid
  membership     OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  company        Company                @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)

  @@id([membershipId, companyId])
}

/// .pfx e senha ficam cifrados com AES-256-GCM (CERT_ENCRYPTION_KEY, fora do banco).
model FiscalCertificate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  fingerprint    String
  holder         String
  document       String
  kind           String
  validUntil     String
  nickname       String   @default("")
  pfxEncrypted   Bytes
  passEncrypted  Bytes
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, fingerprint])
  @@unique([organizationId, id])
}

model FiscalSettings {
  organizationId          String    @id @db.Uuid
  procuratorCertificateId String?   @db.Uuid
  scheduleActive          Boolean   @default(false)
  scheduleTime            String    @default("02:00")
  lastRunDay              String    @default("")
  runStatus               String    @default("")
  runStartedAt            DateTime?
  runFinishedAt           DateTime?
  runLines                Json      @default("[]")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model NfseState {
  organizationId String    @db.Uuid
  companyId      String    @db.Uuid
  environment    String
  lastNsu        BigInt    @default(0)
  blockedUntil   DateTime?
  attempts       Int       @default(0)
  lastCaptureAt  DateTime?
  lastError      String?
  leaseUntil     DateTime?

  company Company @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, companyId, environment])
}

model NfseDocument {
  organizationId  String    @db.Uuid
  companyId       String    @db.Uuid
  environment     String
  chave           String
  nsu             BigInt
  papel           String
  competencia     String
  dataCompetencia String
  emissao         String
  numero          String
  serie           String
  nDps            String
  cstat           String
  prestDoc        String
  prestNome       String
  tomaDoc         String
  tomaNome        String
  intermDoc       String
  opSimples       String
  tribNac         String
  tribMun         String
  descNac         String
  descricao       String
  cNbs            String
  xNbs            String
  cLocIncid       String
  cnoObra         String
  munIncid        String
  tribIssqn       String
  tpRetIss        String
  aliq            String
  tpRetPis        String
  vServ           Decimal   @db.Decimal(15, 2)
  vBc             Decimal   @db.Decimal(15, 2)
  vIss            Decimal   @db.Decimal(15, 2)
  vRetCp          Decimal   @db.Decimal(15, 2)
  vRetIrrf        Decimal   @db.Decimal(15, 2)
  vRetCsll        Decimal   @db.Decimal(15, 2)
  vPis            Decimal   @db.Decimal(15, 2)
  vCofins         Decimal   @db.Decimal(15, 2)
  vTotalRet       Decimal   @db.Decimal(15, 2)
  vLiq            Decimal   @db.Decimal(15, 2)
  vIbs            Decimal   @db.Decimal(15, 2)
  vCbs            Decimal   @db.Decimal(15, 2)
  situacao        String    @default("normal")
  eventsCheckedAt DateTime?
  xmlGz           Bytes

  company Company @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, companyId, environment, chave])
  @@index([organizationId, companyId, environment, competencia])
}

model NfseEvent {
  organizationId String  @db.Uuid
  companyId      String  @db.Uuid
  environment    String
  id             String
  chave          String
  nsu            BigInt?
  codigo         String
  tipo           String
  data           String
  xmlGz          Bytes

  company Company @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, companyId, environment, id])
  @@index([organizationId, companyId, environment, chave])
}

model NfseFailure {
  organizationId String   @db.Uuid
  companyId      String   @db.Uuid
  environment    String
  nsu            BigInt
  chave          String
  motivo         String
  em             DateTime

  company Company @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, companyId, environment, nsu])
}

model DfeState {
  organizationId String    @db.Uuid
  companyId      String    @db.Uuid
  environment    String
  servico        String
  lastNsu        BigInt    @default(0)
  maxNsu         BigInt    @default(0)
  nextAt         DateTime?
  corte          String
  lastCaptureAt  DateTime?
  lastError      String?
  leaseUntil     DateTime?

  company Company @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, companyId, environment, servico])
}

model DfeDocument {
  organizationId String    @db.Uuid
  companyId      String    @db.Uuid
  environment    String
  servico        String
  chave          String
  nsu            BigInt
  conteudo       String
  modelo         String
  papel          String
  numero         String
  serie          String
  emissao        String
  competencia    String
  emitDoc        String
  emitNome       String
  destDoc        String
  destNome       String
  tpNf           String
  vTotal         Decimal   @db.Decimal(15, 2)
  situacao       String    @default("normal")
  ciencia        String    @default("")
  cienciaEm      DateTime?
  cienciaMsg     String    @default("")
  xmlGz          Bytes

  company Company @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, companyId, environment, servico, chave])
  @@index([organizationId, companyId, environment, servico, competencia])
  @@index([organizationId, companyId, environment, ciencia])
}

model DfeEvent {
  organizationId String  @db.Uuid
  companyId      String  @db.Uuid
  environment    String
  servico        String
  chave          String
  tipo           String
  seq            String
  nsu            BigInt
  data           String
  xmlGz          Bytes

  company Company @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, companyId, environment, servico, chave, tipo, seq])
}

model DfeFailure {
  organizationId String   @db.Uuid
  companyId      String   @db.Uuid
  environment    String
  servico        String
  nsu            BigInt
  motivo         String
  em             DateTime

  company Company @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, companyId, environment, servico, nsu])
}

/// Cadastro da empresa. Salvar o memorando cria ou atualiza a Company; é o único lugar de cadastro.
model Memorandum {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  companyId      String   @db.Uuid
  seq            Int
  ano            Int
  /// ativo | cancelado
  status         String   @default("ativo")
  /// ativa | inativa (saída do cliente)
  clientStatus   String   @default("ativa")
  exitDate       String   @default("")
  exitReason     String   @default("")
  exitNotes      String   @default("")
  data           Json
  history        Json     @default("[]")
  createdByName  String   @default("")
  updatedByName  String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, ano, seq])
  @@index([organizationId, companyId])
}

model FinAccount {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  companyId      String  @db.Uuid
  name           String
  bank           String  @default("")
  openingBalance Decimal @default(0) @db.Decimal(15, 2)
  active         Boolean @default(true)

  company Company @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)
  lines   FinStatementLine[]

  @@unique([organizationId, id])
  @@index([organizationId, companyId])
}

model FinCategory {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  companyId      String  @db.Uuid
  name           String
  /// receita | despesa
  kind           String
  active         Boolean @default(true)

  company Company @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, companyId, kind, name])
  @@unique([organizationId, id])
}

model CostCenter {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  companyId      String  @db.Uuid
  name           String
  active         Boolean @default(true)

  company Company @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, companyId, name])
  @@unique([organizationId, id])
}

/// Conta a pagar ou a receber. Recorrências são parcelas com o mesmo groupId.
model FinEntry {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  companyId      String    @db.Uuid
  /// pagar | receber
  kind           String
  description    String
  partyName      String    @default("")
  partyDoc       String    @default("")
  docNumber      String    @default("")
  categoryId     String?   @db.Uuid
  costCenterId   String?   @db.Uuid
  accountId      String?   @db.Uuid
  issueDate      String
  dueDate        String
  amount         Decimal   @db.Decimal(15, 2)
  /// aberto | aguardando | pago | cancelado | rejeitado
  status         String    @default("aberto")
  paidDate       String    @default("")
  paidAmount     Decimal?  @db.Decimal(15, 2)
  groupId        String?   @db.Uuid
  installment    Int       @default(1)
  installments   Int       @default(1)
  notes          String    @default("")
  createdById    String    @db.Uuid
  createdByName  String    @default("")
  approvedByName String    @default("")
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())

  company     Company            @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)
  attachments FinAttachment[]
  lines       FinStatementLine[]

  @@unique([organizationId, id])
  @@index([organizationId, companyId, dueDate])
  @@index([organizationId, companyId, status])
}

model FinAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  entryId        String   @db.Uuid
  name           String
  mime           String
  content        Bytes
  createdAt      DateTime @default(now())

  entry FinEntry @relation(fields: [organizationId, entryId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, entryId])
}

/// Linha do extrato OFX. fitId evita importar a mesma linha duas vezes.
model FinStatementLine {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  accountId      String  @db.Uuid
  fitId          String
  date           String
  amount         Decimal @db.Decimal(15, 2)
  memo           String  @default("")
  entryId        String? @db.Uuid
  ignored        Boolean @default(false)

  account FinAccount @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Cascade)
  entry   FinEntry?  @relation(fields: [organizationId, entryId], references: [organizationId, id], onDelete: NoAction)

  @@unique([organizationId, accountId, fitId])
}

model StockItem {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  companyId      String  @db.Uuid
  code           String
  name           String
  unit           String  @default("UN")
  minQty         Decimal @default(0) @db.Decimal(15, 3)
  qty            Decimal @default(0) @db.Decimal(15, 3)
  avgCost        Decimal @default(0) @db.Decimal(15, 4)
  active         Boolean @default(true)

  company Company     @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)
  moves   StockMove[]

  @@unique([organizationId, companyId, code])
  @@unique([organizationId, id])
}

model StockMove {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  itemId         String   @db.Uuid
  /// entrada | saida | ajuste
  type           String
  qty            Decimal  @db.Decimal(15, 3)
  unitCost       Decimal  @default(0) @db.Decimal(15, 4)
  date           String
  note           String   @default("")
  byName         String   @default("")
  createdAt      DateTime @default(now())

  item StockItem @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, itemId])
}

/// Registro imutável de ações sensíveis.
model AuditEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @db.Uuid
  userId         String?   @db.Uuid
  action         String
  target         String    @default("")
  detail         Json      @default("{}")
  createdAt      DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}
